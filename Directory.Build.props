<Project>
 <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>5.5.0</Version>
    <Authors>Gary Hughes</Authors>
    <Copyright>Copyright © 2021 Gary Hughes</Copyright>
    <RepositoryUrl>https://github.com/GaryHughes/FixClient</RepositoryUrl>
    <PackageProjectUrl>https://github.com/GaryHughes/FixClient</PackageProjectUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
 </PropertyGroup>
</Project>